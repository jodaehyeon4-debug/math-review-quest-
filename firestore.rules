rules_version = '2';
// 수학 복습 퀘스트 Firestore 규칙 (기본안)
// - 학생 태블릿: 익명 로그인 상태에서 학생 기록(students/*)을 읽고 씀
// - 학급 설정(config/class): 누구나 읽고, 교사 계정(TEACHER_UID)만 씀
// TEACHER_UID 는 Firebase 콘솔 Authentication 에서 교사 계정을 만든 뒤 그 UID로 바꾸세요.
// 주의: 현재 앱은 교사 비밀번호를 config/class 안에 두고 화면에서 비교합니다. 실제 배포 전에
//       교사 로그인을 Firebase Auth(이메일)로 바꾸고 pw 필드를 지우는 것을 권장합니다. (docs/HANDOFF.md 3절)
service cloud.firestore {
  match /databases/{db}/documents {
    match /students/{sid} {
      // 목록 읽기(교사 기록장, 보물상자)는 문서 이름을 미리 알 수 없어서 따로 허용
      allow list: if request.auth != null;
      allow get, write: if request.auth != null && sid.matches('s[0-9]{2}');
    }
    match /config/class {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'TEACHER_UID';
    }
    match /{document=**} { allow read, write: if false; }
  }
}
